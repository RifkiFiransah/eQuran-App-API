    {
      "name": "4. Surat Lokal (CRUD)",
      "item": [
        {
          "name": "Create Surat",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get('baseUrl') || pm.collectionVariables.get('baseUrl');",
                  "pm.sendRequest(baseUrl + '/surats?limit=114', function (err, response) {",
                  "  const used = [];",
                  "  if (!err && response.code === 200) {",
                  "    const body = response.json();",
                  "    (body.data.surat || []).forEach(function (surat) { used.push(surat.nomor); });",
                  "  }",
                  "  const available = [];",
                  "  for (let nomor = 1; nomor <= 114; nomor++) {",
                  "    if (!used.includes(nomor)) { available.push(nomor); }",
                  "  }",
                  "  const picked = available.length ? available[Math.floor(Math.random() * available.length)] : 1;",
                  "  pm.collectionVariables.set('suratNomor', String(picked));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Response success', () => pm.expect(body.status).to.eql('success'));",
                  "pm.test('ID surat tersedia', () => pm.expect(body.data.surat.id).to.be.a('string').and.not.empty);",
                  "if (body.data && body.data.surat) {",
                  "  pm.collectionVariables.set('suratId', body.data.surat.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nomor\": {{suratNomor}}, \"nama\": \"Surat Postman\", \"jumlahAyat\": 7, \"turun\": \"mekah\", \"arti\": \"Pembukaan\", \"deskripsi\": \"Dibuat oleh Postman\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/surats"
          }
        },
        {
          "name": "Daftar Surat Lokal",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/surats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response success', () => pm.expect(body.status).to.eql('success'));",
                  "pm.test('Ada data lokal', () => pm.expect(body.data.total).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
