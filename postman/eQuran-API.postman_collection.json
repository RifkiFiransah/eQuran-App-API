                  "pm.test('Arti sudah diperbarui', () => pm.expect(body.data.surat.arti).to.eql('Arti dari Postman'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Legacy - Create /surat",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get('baseUrl') || pm.collectionVariables.get('baseUrl');",
                  "pm.sendRequest(baseUrl + '/surats?limit=114', function (err, response) {",
                  "  const used = [];",
                  "  if (!err && response.code === 200) {",
                  "    const body = response.json();",
                  "    (body.data.surat || []).forEach(function (surat) { used.push(surat.nomor); });",
                  "  }",
                  "  const available = [];",
                  "  for (let nomor = 1; nomor <= 114; nomor++) {",
                  "    if (!used.includes(nomor)) { available.push(nomor); }",
                  "  }",
                  "  const picked = available.length ? available[Math.floor(Math.random() * available.length)] : 1;",
                  "  pm.collectionVariables.set('aliasSuratNomor', String(picked));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Response success', () => pm.expect(body.status).to.eql('success'));",
                  "if (body.data && body.data.surat) {",
                  "  pm.collectionVariables.set('aliasSuratId', body.data.surat.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nomor\": {{aliasSuratNomor}}, \"nama\": \"Surat Alias Postman\", \"jumlahAyat\": 7, \"turun\": \"mekah\", \"arti\": \"Pembukaan\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/surat"
          }
        },
        {
          "name": "Legacy - Delete /surat/{id}",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/surat/{{aliasSuratId}}"
